#!/usr/bin/env node

// =============================================================================
// AirDrop-LLM — Daemon Runtime Engine & Telemetry Gateway
// =============================================================================
//
// Dual-link Architecture:
//   1. HTTP UI & REST API Server (port 3000)
//      - Endpoints: /api/status, /api/nodes, /api/infer, /api/result/:id, /api/health,
//                   /api/recommendations, /api/nodes/join, /api/nodes/eject, /api/shutdown
//      - Serves Valkyrie-HUD static assets (HTML/CSS/JS)
//   2. Real-time Telemetry WebSocket Gateway (port 3001)
//      - Streams real-time telemetry pulses to ws://localhost:3001
//      - Truthful node tracking (Zero fake peers)
//      - Dynamic Asymmetric Layer Scheduling across connected nodes
//      - Combined Hardware Model Recommendation Engine
//      - P2P UDP Discovery (port 9998) & Local AI lifecycle manager (Ollama / GGUF)
// =============================================================================

"use strict";

const http = require("http");
const fs = require("fs");
const path = require("path");
const os = require("os");
const crypto = require("crypto");
const dgram = require("dgram");
const url = require("url");
const { spawn, execSync } = require("child_process");

// ---------------------------------------------------------------------------
// CLI Argument Parsing
// ---------------------------------------------------------------------------

const args = process.argv.slice(2);
let mode = "master";
let uiPort = 3000;
let wsPort = 3001;
let rawModelArg = null;
let verbose = false;

const MODELS_DIR = path.join(os.homedir(), ".airdrop-llm", "models");

for (const arg of args) {
  if (arg.startsWith("--mode=")) {
    mode = arg.split("=")[1];
  } else if (arg.startsWith("--ui-port=")) {
    uiPort = parseInt(arg.split("=")[1], 10) || 3000;
  } else if (arg.startsWith("--ws-port=")) {
    wsPort = parseInt(arg.split("=")[1], 10) || 3001;
  } else if (arg.startsWith("--model=")) {
    rawModelArg = arg.split("=")[1];
  } else if (arg === "--verbose") {
    verbose = true;
  }
}

